<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TourSearch.Api — the MCP server (Streamable HTTP) and the HTTP surface.

       HARD RULE, enforced by the build graph: this project must NOT reference
       TourSearch.Scraper. No Playwright, no Chromium, no browser in the API
       process (docs/architecture.md#why-api-must-not-depend-on-scraper-decided).
       It also never starts BackgroundService (docs/runtime.md#startup).

       "ASP.NET Core (Minimal APIs)" in .NET 10 is the default shape of
       Microsoft.NET.Sdk.Web — routing/handlers without controllers
       (verified: `dotnet new web`/`webapi` emit Microsoft.NET.Sdk.Web, net10.0,
       and no controller packages). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TourSearch.Core/TourSearch.Core.csproj" />
    <ProjectReference Include="../TourSearch.Infrastructure/TourSearch.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP server SDK for the three shipped tools (docs/mcp-tools.md).
         Transport must be Streamable HTTP, not the stdio default.

         The HTTP hosting — MapMcp, WithHttpTransport, the /mcp endpoint — lives in
         ModelContextProtocol.AspNetCore, NOT in the bare ModelContextProtocol package:
         that package ships only the stdio and raw-stream transports (verified against the
         assemblies of both 2.1.0 and 2.2.0, and by a probe that could not resolve MapMcp).
         The AspNetCore package brings the core package transitively, so it is referenced
         alone — keeping the old bare reference alongside it would be a version conflict.
         See docs/adr/043-mcp-hosted-over-streamable-http.md. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
