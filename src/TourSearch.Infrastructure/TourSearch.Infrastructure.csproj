<Project Sdk="Microsoft.NET.Sdk">

  <!-- TourSearch.Infrastructure — the ONE TourSearchDbContext and the repositories
       that hang off it. docs/architecture.md: exactly one DbContext in the system;
       it lives here, and Migration references it instead of redeclaring it.

       Packages are pinned exactly (docs/conventions.md: "Package versions pinned
       exactly, never 'latest'"). Versions verified against NuGet on 2026-10-13. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TourSearch.Core/TourSearch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 + PostgreSQL provider + snake_case naming (docs/database.md) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- DI: Scoped by default; Singleton only for shared state (docs/conventions.md) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
