<Project Sdk="Microsoft.NET.Sdk">

  <!-- TourSearch.UnitTests — domain logic + parser, run against committed fixtures.

       docs/conventions.md ("Testing"): no test may contact TourVisor.ru. Parser
       tests read known-good HTML snapshots from tests/fixtures/ (see
       tests/fixtures/README.md). No network, ever. -->

  <PropertyGroup>
    <OutputType>Test</OutputType>
    <!-- Parallelization policy (MSTEST0001, open question 12): declared where the
         analyzer wants it — as an assembly attribute in AssemblyInfo.cs, not as a
         NoWarn. Chosen policy: [assembly: Parallelize(Scope = ExecutionScope.MethodLevel)]
         — these tests are in-memory model/reflection assertions that share no state.
         See docs/adr/036-test-parallelization-policy.md.

         The integration test project keeps its interim suppression: it still has no
         .cs file, and its shared Testcontainers PostgreSQL makes the policy a separate
         decision. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TourSearch.Core/TourSearch.Core.csproj" />
    <ProjectReference Include="../../src/TourSearch.Infrastructure/TourSearch.Infrastructure.csproj" />
    <ProjectReference Include="../../src/TourSearch.Scraper/TourSearch.Scraper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <!-- The model-shape tests build the model and read the generated script, so they
         need EF Core, the Npgsql provider and the snake_case naming plugin directly.
         Versions mirror src/TourSearch.Infrastructure/TourSearch.Infrastructure.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
